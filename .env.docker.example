# ============================================================
# RUNTIME MODE
# ============================================================
UAT_RUNTIME_MODE=docker

# ============================================================
# DATABASE (Docker Container Service: db)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/servicenow_qa

# ============================================================
# REDIS & CELERY (Docker Container Service: redis with TLS)
# ============================================================
SESSION_STORE_TYPE=redis
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD
REDIS_TLS_DIR=/app/tls/redis
REDIS_TLS_CA_CERT=/app/tls/redis/ca.crt
REDIS_TLS_CERT=/app/tls/redis/redis.crt
REDIS_TLS_KEY=/app/tls/redis/redis.key
REDIS_URL=rediss://:YOUR_SECURE_REDIS_PASSWORD@redis:6379/0?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://:YOUR_SECURE_REDIS_PASSWORD@redis:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://:YOUR_SECURE_REDIS_PASSWORD@redis:6379/1?ssl_cert_reqs=required

# ============================================================
# OUTPUT DIRECTORIES (Container Absolute Paths)
# ============================================================
REPORT_OUTPUT_DIR=/app/reports
SCREENSHOT_DIR=/app/screenshots

# ============================================================
# BROWSER / PLAYWRIGHT (Docker Container Execution)
# ============================================================
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_SHOW_MOUSE_CURSOR=false
BROWSER_KEEP_BROWSER_OPEN=false
BROWSER_INTERACTIVE_TIMEOUT_SECONDS=300

# ============================================================
# FRONTEND ROUTING
# ============================================================
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://api:8000

# ============================================================
# SERVICENOW INSTANCE & SAFETY CONTROLS
# ============================================================
SERVICENOW_INSTANCE_URL=https://devXXXXXXXX.service-now.com
SERVICENOW_ALLOWED_INSTANCES=devXXXXXXXX.service-now.com
SERVICENOW_IS_SUBPRODUCTION=true
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD

# ============================================================
# LLM (NVIDIA NIM / GLM-5.2 or OpenAI / Anthropic)
# ============================================================
OPENAI_API_KEY=YOUR_NVIDIA_OR_OPENAI_API_KEY
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.2
LLM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
LLM_EMBEDDING_DIMENSIONS=2048

# ============================================================
# PERCEPTION LAYER
# ============================================================
PUTER_ENDPOINT=https://api.puter.com/puterai/openai/v1/chat/completions
PUTER_API_KEY=YOUR_PUTER_API_KEY
MOONDREAM_API_KEY=YOUR_MOONDREAM_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ============================================================
# APPLICATION AUTHENTICATION
# ============================================================
QA_ADMIN_USERNAME=qa-admin
QA_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256

# ============================================================
# LOGGING & ENVIRONMENT
# ============================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
