# ============================================================
# RUNTIME MODE
# ============================================================
UAT_RUNTIME_MODE=local

# ============================================================
# DATABASE (Local PostgreSQL with pgvector)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/servicenow_qa

# ============================================================
# REDIS & CELERY (Local Redis / Memurai / WSL Redis)
# ============================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ============================================================
# OUTPUT DIRECTORIES (Resolved relative to repository root)
# ============================================================
REPORT_OUTPUT_DIR=./reports
SCREENSHOT_DIR=./screenshots

# ============================================================
# BROWSER / PLAYWRIGHT (Local Headed Execution)
# ============================================================
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=250
BROWSER_SHOW_MOUSE_CURSOR=true
BROWSER_KEEP_BROWSER_OPEN=true
BROWSER_INTERACTIVE_TIMEOUT_SECONDS=300

# ============================================================
# FRONTEND ROUTING
# ============================================================
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# ============================================================
# SERVICENOW INSTANCE
# ============================================================
SERVICENOW_INSTANCE_URL=https://devXXXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD

# ============================================================
# LLM (NVIDIA NIM / GLM-5.2 or OpenAI / Anthropic)
# ============================================================
OPENAI_API_KEY=YOUR_NVIDIA_OR_OPENAI_API_KEY
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.2
LLM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
LLM_EMBEDDING_DIMENSIONS=2048

# ============================================================
# PERCEPTION LAYER
# ============================================================
PUTER_ENDPOINT=https://api.puter.com/puterai/openai/v1/chat/completions
PUTER_API_KEY=YOUR_PUTER_API_KEY
MOONDREAM_API_KEY=YOUR_MOONDREAM_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ============================================================
# APPLICATION AUTHENTICATION
# ============================================================
QA_ADMIN_USERNAME=qa-admin
QA_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256

# ============================================================
# LOGGING & ENVIRONMENT
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
