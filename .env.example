# ============================================================
# SERVICENOW
# ============================================================

SERVICENOW_INSTANCE_URL=https://devXXXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD


# ============================================================
# LLM (NVIDIA NIM / GLM-5.2)
# ============================================================

# API key for whichever LLM provider you are actually using
OPENAI_API_KEY=YOUR_NVIDIA_API_KEY

# Provider configuration used by the LLM client
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.2


# ============================================================
# UI-TARS / VISUAL GROUNDING
# ============================================================

PUTER_ENDPOINT=https://api.puter.com/puterai/openai/v1/chat/completions
PUTER_API_KEY=YOUR_PUTER_API_KEY


# ============================================================
# POSTGRESQL
# ============================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/servicenow_qa


# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ============================================================
# APPLICATION
# ============================================================

# Application/API authentication
QA_ADMIN_USERNAME=qa-admin
QA_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

# ============================================================
# FRONTEND (Codespaces / Docker)
# ============================================================

# API Base URL for the frontend (e.g., https://<codespace>-8000.app.github.dev)
VITE_API_BASE_URL=

# ============================================================
# BROWSER / PLAYWRIGHT
# ============================================================

BROWSER_HEADLESS=false
BROWSER_SLOW_MO=250
BROWSER_SHOW_MOUSE_CURSOR=true
BROWSER_KEEP_BROWSER_OPEN=true

ENVIRONMENT=validation
LOG_LEVEL=INFO
