# =============================================================================
# ServiceNow QA Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# --- LLM Configuration ---
LLM_PROVIDER=groq
LLM_API_KEY=YOUR_GROQ_API_KEY
LLM_MODEL=openai/gpt-oss-120b

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- ServiceNow Configuration ---
SERVICENOW_INSTANCE_URL=https://devXXXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD

# --- Browser Configuration ---
BROWSER_HEADLESS=false                        # true for CI, false for debugging
BROWSER_SLOW_MO=0                             # Milliseconds to slow down actions
BROWSER_TIMEOUT=30000                         # Default timeout in ms
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# --- Agent Configuration ---
AGENT_MAX_STEPS=100                           # Max steps before forced termination
AGENT_MAX_RETRIES=3                           # Max recovery retries per action
AGENT_OBSERVATION_WINDOW=10                   # Number of observations to keep in memory

# --- Logging ---
LOG_LEVEL=INFO                                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                            # console | json

# --- Reporting ---
REPORT_OUTPUT_DIR=reports
SCREENSHOT_DIR=screenshots
