# ============================================================
# SERVICENOW & SAFETY CONTROLS
# ============================================================

SERVICENOW_INSTANCE_URL=https://devXXXXXXXX.service-now.com
SERVICENOW_ALLOWED_INSTANCES=devXXXXXXXX.service-now.com
SERVICENOW_IS_SUBPRODUCTION=true
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD


# ============================================================
# LLM (Google Gemini via its OpenAI-compatible API)
# ============================================================

# API key for whichever LLM provider you are actually using
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# Provider configuration used by the LLM client
LLM_PROVIDER=google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Embeddings remain on the existing NVIDIA endpoint/model and use OPENAI_API_KEY.
OPENAI_API_KEY=YOUR_NVIDIA_API_KEY
LLM_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1


# ============================================================
# UI-TARS / VISUAL GROUNDING
# ============================================================

PUTER_ENDPOINT=https://api.puter.com/puterai/openai/v1/chat/completions
PUTER_API_KEY=YOUR_PUTER_API_KEY


# ============================================================
# POSTGRESQL
# ============================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/servicenow_qa


# ============================================================
# REDIS
# ============================================================

SESSION_STORE_TYPE=redis
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ============================================================
# APPLICATION
# ============================================================

# Application/API authentication
QA_ADMIN_USERNAME=qa-admin
QA_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

# ============================================================
# FRONTEND (Codespaces / Docker)
# ============================================================

# API Base URL for the frontend (e.g., https://<codespace>-8000.app.github.dev)
VITE_API_BASE_URL=

# ============================================================
# BROWSER / PLAYWRIGHT
# ============================================================

BROWSER_HEADLESS=false
BROWSER_SLOW_MO=250
BROWSER_SHOW_MOUSE_CURSOR=true
BROWSER_KEEP_BROWSER_OPEN=true

ENVIRONMENT=validation
LOG_LEVEL=INFO


# ============================================================
# LAYA ACTION POLICY (optional — local browser-level decisions)
# ============================================================
# The LAYA action-policy adapter makes browser-level micro-decisions
# (which visible control to click/fill/select) using a local LAYA
# decision model. This is SEPARATE from the remote LAYA verifier
# adapter (LAYA_* vars above). The action policy does NOT require Jev
# endpoint credentials — it runs locally.
#
# SIMPLEST PATH (recommended):
#   pip install laya
#   LAYA_ACTION_ENABLED=true
#   LAYA_ACTION_MODE=primary
# The laya.Router auto-downloads the checkpoint from HuggingFace on
# first use. No checkpoint path or API key needed.
#
# Modes:
#   shadow  — runs LAYA but records decisions for comparison without
#             using them; existing Gemini path runs unchanged (default)
#   primary — uses LAYA decisions when confidence >= threshold; falls
#             back to Gemini on low confidence / timeout / model failure
#
#LAYA_ACTION_ENABLED=false
#LAYA_ACTION_MODE=shadow
#
# Optional: pin a specific checkpoint (defaults to laya.Router auto-download)
#LAYA_ACTION_CHECKPOINT=convaiinnovations/laya
#LAYA_ACTION_MODEL_SUBFOLDER=typed-decisions
#LAYA_ACTION_DEVICE=auto
#LAYA_ACTION_CONFIDENCE_THRESHOLD=0.65
#LAYA_ACTION_INFERENCE_TIMEOUT_SECONDS=5.0
#LAYA_ACTION_MAX_CANDIDATES=250
#LAYA_ACTION_MODEL_MAX_LEN=2048
#LAYA_ACTION_HEAD_MAX_LEN=768
#
# Optional: remote API mode (jev-ultrafast style, no local deps needed)
#LAYA_ACTION_ENDPOINT=https://api.typesafe.ai
#LAYA_ACTION_API_KEY=YOUR_LAYA_API_KEY
#LAYA_ACTION_WARMUP_AT_STARTUP=true
