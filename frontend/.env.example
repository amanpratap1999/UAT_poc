# Frontend Environment Variables
# Copy to .env.local for local/Codespaces development — never commit .env.local

# Base URL of the FastAPI backend (no trailing slash).
# Examples:
#   GitHub Codespaces: https://<codespace-name>-8000.app.github.dev
#   Custom domain / Reverse proxy: https://api.yourdomain.com
#   Leave empty for same-origin / relative proxying
VITE_API_BASE_URL=
